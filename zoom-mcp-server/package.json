{
  "name": "zoom-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that creates Zoom meetings via Zoom Server-to-Server OAuth",
  "type": "module",
  "bin": {
    "zoom-mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "test-meeting": "tsc && node dist/test-meeting.js"
  },
  "keywords": [
    "mcp",
    "zoom",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
