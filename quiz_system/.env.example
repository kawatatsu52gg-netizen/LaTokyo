# ============================================================
# 環境変数テンプレート（このファイルは .env.example）
#   実際の値は .env にコピーして記入すること。
#   .env は .gitignore 済み。APIキー・認証情報をコードへ直接書かないこと。
# ============================================================

# --- Google Drive 連携（任意 / MVPでは不要）---------------------
# このMVPは inbox/ にファイルを置く方式で完結します。
# Google Drive から自動取得する場合のみ以下を使用します。
# 認証は Claude Code の Google Drive MCP（最小権限OAuth）を利用し、
# パスワード・Cookie・ブラウザログイン情報はここに保存しません。
GOOGLE_DRIVE_ENABLED=false
# NotebookLM書き出しを集約したDriveフォルダのID（共有しない・読み取り専用推奨）
GOOGLE_DRIVE_FOLDER_ID=

# --- 実行設定（任意）------------------------------------------
# 公開に必要な最小エビデンスレベル（A/B/C/D）
MIN_EVIDENCE_LEVEL_FOR_PUBLISH=B
