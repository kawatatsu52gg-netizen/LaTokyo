# ============================================================
# LaTokyo 予約同期システム 環境変数テンプレート
# 本ファイルをコピーして .env を作成してください（.env はコミットしない）
# 本番では Secret Manager を使用し、平文の値をリポジトリに残さないこと
# ============================================================

# ---- アプリ ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
TZ=Asia/Tokyo

# ---- データベース (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latokyo?schema=public

# ---- トークン暗号化 (AES-256-GCM) ----
# 32バイトのランダム値を base64 で。生成例: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Square
# ============================================================
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
# 単一サロン運用の初期はアクセストークンでよい（OAuth移行も可能）
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook署名検証用（Developer Dashboardで発行される署名キー）
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Webhookの通知先URL（署名計算に使用。末尾まで完全一致させる）
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/webhooks/square
# 実装時点の公式推奨安定版に固定する
SQUARE_API_VERSION=2025-10-16
# OAuthを使う場合のみ（単一運用では未使用でよい）
SQUARE_OAUTH_CLIENT_ID=
SQUARE_OAUTH_CLIENT_SECRET=

# ============================================================
# SALON BOARD / HOT PEPPER Beauty （公式APIなし → 通知メール解析のみ）
# 「予約お知らせメール一覧」に登録した受信専用アドレスの受信箱を読む
# ============================================================
# 通知メールの送信元アドレス（フィルタ用）例: reserve@beauty.hotpepper.jp 等、実物で確認して設定
SALONBOARD_NOTIFICATION_FROM=
# 通知メールを受信するメールアドレス（自分の受信箱）
SALONBOARD_INBOX_ADDRESS=

# ---- Gmail API（本番でメールをpull/watchする場合）----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ============================================================
# 通知（Slack / Gmail / LINE のいずれか。使うものだけ設定）
# 通知本文には顧客の詳細個人情報を載せない（日時・予約元・メニュー・エラー概要・管理URLのみ）
# ============================================================
NOTIFY_CHANNEL=slack

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# Gmail送信（送信元）
NOTIFY_GMAIL_FROM=
NOTIFY_ADMIN_EMAIL=

# ---- 同期挙動 ----
# ジョブ最大再試行回数（超えたら管理者通知）
SYNC_MAX_RETRIES=5
# デフォルトの施術前後準備時間（分）。サービスごとにDBで上書き可能
DEFAULT_PREP_MINUTES_BEFORE=0
DEFAULT_PREP_MINUTES_AFTER=10
